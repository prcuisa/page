NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://prcuisa.com

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Enable only on the canonical public acquisition deployment, never previews.
INDEX_PUBLIC_CONTENT=false

# Firebase Google sign-in (public web app configuration, not Admin credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Connect: same server-only encryption key on Vercel and worker (32 bytes, 64 hex chars).
CONNECT_ENCRYPTION_KEY=
CONNECT_APP_URL=https://app.prcuisa.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
RESEND_API_KEY=
CONNECT_EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CONNECT_WEBHOOK_ENABLED=false
